POSTGRES_DB=store
POSTGRES_USER=store
POSTGRES_PASSWORD=store-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_SECRET_KEY=replace-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,api-alorchoya.newsmartagent.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://alorchoya.newsmartagent.com
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=product-images
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=minio-alorchoya.newsmartagent.com
NEXT_PUBLIC_API_URL=https://api-alorchoya.newsmartagent.com/api
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token

# Host Ports Customization (Change these if host ports clash with other projects)
HTTP_PORT=80
BACKEND_PORT=8000
FRONTEND_PORT=3000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Google OAuth / customer login. Keep the secret server-side only.
PUBLIC_APP_URL=https://alorchoya.newsmartagent.com
COOKIE_DOMAIN=.newsmartagent.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api-alorchoya.newsmartagent.com/api/auth/google/callback/
# Facebook Page Messenger link (set your real page username in .env)
NEXT_PUBLIC_MESSENGER_URL=https://m.me/your-page-username
